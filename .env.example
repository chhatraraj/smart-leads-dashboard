# Server environment example for GigFlow

NODE_ENV=development
PORT=5000

# MongoDB connection string (replace with your URI)
MONGO_URI=mongodb://localhost:27017/gigflow

# JWT secrets (use strong, randomly generated values - min 32 characters)
JWT_SECRET=replace_with_32+_char_secret
JWT_REFRESH_SECRET=replace_with_32+_char_refresh_secret

# Token lifetimes
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Frontend origin for CORS
CLIENT_URL=http://localhost:5173
